<drachtio>
    <!-- admin port for client (node.js app) connections -->
    <admin port="9022" secret="cymru">0.0.0.0</admin>

    <!-- sip configuration -->
    <sip>
        <contacts>
            <contact external-ip="192.168.1.45" local-net="172.18.0.0/16">sip:*:5060;transport=udp,tcp</contact>
        </contacts>
    </sip>

    <!-- route INVITEs via sbc-call-router for proper inbound/outbound routing -->
    <request-handlers>
        <request-handler sip-method="INVITE" http-method="POST" verify-peer="false">http://sbc-call-router:3000</request-handler>
    </request-handlers>

    <!-- logging configuration -->
    <logging>
        <loglevel>debug</loglevel>
        <sofia-loglevel>3</sofia-loglevel>
    </logging>
</drachtio>
